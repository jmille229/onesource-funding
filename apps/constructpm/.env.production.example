# ConstructPM — Turnkey VPS production config
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.production` on the server, fill in the values, and keep it out of
# git (it's already gitignored). docker-compose.prod.yml reads these variables.
#
# The RS256 JWT key pair is NOT set here — it lives as two files under ./secrets
# (jwt_private.pem / jwt_public.pem). See DEPLOY.md.
#
# Generate strong secrets with: openssl rand -base64 36

# ─── Your domain (DNS A record must already point at this VPS) ────────────────
DOMAIN=app.os-funding.com

# ─── Funding application (apply.os-funding.com) ───────────────────────────────
# The public application prospects fill in without an account. Needs its own DNS
# A record pointing at this VPS; Caddy gets its certificate automatically.
APPLY_DOMAIN=apply.os-funding.com
# Encrypts applicants' business EIN and everyone's two-step sign-in secrets.
# REQUIRED: without it the application and two-step sign-in (mandatory for the
# console) are off. Generate once with:
#   openssl rand -base64 32
# Keep a copy in your password manager. If it's lost, stored EINs can't be read
# and everyone has to set up two-step sign-in again.
APPLICATION_DATA_KEY=

# ─── Which images to run ──────────────────────────────────────────────────────
# Leave as `latest`: infra/deploy.sh picks the exact build for the code you
# pulled, and `./infra/deploy.sh --rollback` returns to the one before.
IMAGE_TAG=latest

# ─── Postgres ─────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD  → the `constructpm` superuser (owns schema, runs migrations)
# CONSTRUCTPM_APP_PASSWORD → the RLS-scoped `constructpm_app` role the API uses
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser
CONSTRUCTPM_APP_PASSWORD=CHANGE_ME_app_role

# ─── Factoring console (optional) ─────────────────────────────────────────────
# Leave blank unless you run the OneSource operator console. When set, the
# migration gives constructpm_factoring_admin LOGIN and the API mounts /api/admin.
# That role reaches factoring data across all clients — and nothing else.
FACTORING_ADMIN_PASSWORD=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis

# ─── File storage (uploaded documents) ────────────────────────────────────────
# Use managed storage: a private bucket at AWS S3, Cloudflare R2, Backblaze B2 or
# DigitalOcean Spaces, with an access key limited to that bucket. Moving from
# the old in-stack MinIO: infra/migrate-files.sh (DEPLOY.md, "File storage").
#
# Leave S3_ENDPOINT unset to keep using the in-stack MinIO (legacy; its image can
# no longer be pulled, so a replacement server couldn't start it).
#   Cloudflare R2:  S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#                   S3_FORCE_PATH_STYLE=true  S3_SERVER_SIDE_ENCRYPTION=none
#   AWS S3:         S3_ENDPOINT=https://s3.amazonaws.com  S3_REGION=us-east-1  S3_FORCE_PATH_STYLE=false
#   Backblaze B2:   S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com  S3_REGION=us-west-004
#   DO Spaces:      S3_ENDPOINT=https://nyc3.digitaloceanspaces.com  S3_REGION=nyc3  S3_SERVER_SIDE_ENCRYPTION=none
S3_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_FILES=constructpm-files

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Symmetric secret is still required by the config schema (min 64 chars) even
# though production access tokens are signed with the RS256 key pair in ./secrets.
JWT_SECRET=CHANGE_ME_at_least_64_characters_long_random_string_xxxxxxxxxxxxxxxx
JWT_ISSUER=constructpm
JWT_AUDIENCE=constructpm-app

# ─── Email ────────────────────────────────────────────────────────────────────
# Needed for invites, password resets, email confirmation and your alerts. Any
# SMTP provider works (Postmark, SendGrid, Amazon SES, Google Workspace,
# Microsoft 365 — see DEPLOY.md → Email). Add the provider's SPF and DKIM DNS
# records for os-funding.com, and a DMARC record, or these land in spam. Check
# from the console: System → Send me a test.
#   Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_USER=the mailbox,
#                     SMTP_PASS=an app password (not your normal password)
#   Microsoft 365:    SMTP_HOST=smtp.office365.com, SMTP_USER=the mailbox
# Port 587 always upgrades to an encrypted connection (STARTTLS); 465 is
# encrypted from the start. SMTP_SECURE only matters for other ports.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Google/Microsoft: the mailbox above, or an alias of it they let you send as.
EMAIL_FROM=noreply@os-funding.com
# Where factoring alerts land — funding requests and onboarding enquiries. This
# is a real mailbox you read, not the noreply sender above. Leave blank and the
# alerts are simply logged instead of sent.
OPS_NOTIFICATION_EMAIL=

# ─── Backups (infra/backup.sh, nightly from cron) ─────────────────────────────
# Encrypts every backup. REQUIRED. Generate with `openssl rand -base64 32` and
# keep it in your password manager — without it no backup can be read.
BACKUP_PASSPHRASE=
# Off-site copy: a bucket at a DIFFERENT provider or account from the files
# above (so one compromised key can't delete both), e.g. Backblaze B2.
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Pinged when a backup starts, succeeds or fails (https://healthchecks.io is
# free): you get an email when a nightly backup fails, or doesn't run at all.
BACKUP_HEALTHCHECK_URL=

# ─── Error tracking (optional) ────────────────────────────────────────────────
# A Sentry project's DSN (or any Sentry-compatible service). You're emailed when
# the app hits an error. No client data is sent.
SENTRY_DSN=

# ─── Malware scanning of uploads ──────────────────────────────────────────────
# Set CLAMAV_HOST=clamav to run the scanner (needs ~1.5 GB of memory: an 8 GB
# server is comfortable). Every upload is scanned; flagged files can't be
# downloaded. With it unset, SKIP_VIRUS_SCAN=true marks uploads as unscanned-clean.
CLAMAV_HOST=
SKIP_VIRUS_SCAN=true

# ─── Business time zone ───────────────────────────────────────────────────────
BUSINESS_TZ=America/New_York
