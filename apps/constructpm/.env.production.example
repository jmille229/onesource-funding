# ConstructPM — Production Environment Variables
# Set these in your cloud platform's secret manager (AWS SSM, GCP Secret Manager,
# Railway, Render, Fly.io, etc.). NEVER commit a filled-in version of this file.

# ─── Database (managed Postgres recommended: RDS, Supabase, Neon, Railway) ────
# App connects as the RLS-subject role `constructpm_app` (NOT the owner — owners
# bypass RLS and break tenant isolation). Migrations run as the admin role.
DATABASE_URL=postgresql://constructpm_app:STRONG_RANDOM_PASSWORD@your-db-host:5432/constructpm_prod?sslmode=require
DATABASE_READER_URL=postgresql://constructpm_app:STRONG_RANDOM_PASSWORD@your-readonly-replica:5432/constructpm_prod?sslmode=require
MIGRATION_DATABASE_URL=postgresql://constructpm:STRONG_RANDOM_PASSWORD@your-db-host:5432/constructpm_prod?sslmode=require

# ─── Redis (managed: Upstash, Redis Cloud, ElastiCache) ───────────────────────
REDIS_URL=rediss://your-redis-host:6380
REDIS_PASSWORD=STRONG_RANDOM_REDIS_PASSWORD

# ─── JWT — RS256 (generate keys: see scripts/generate-jwt-keys.sh) ────────────
# Paste the full PEM content, with literal \n for newlines when using env vars
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=https://api.yourdomain.com
JWT_AUDIENCE=constructpm-app

# ─── Storage (AWS S3 recommended for production) ──────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_SECRET_KEY=STRONG_RANDOM_S3_SECRET
S3_BUCKET_FILES=constructpm-prod-files
S3_FORCE_PATH_STYLE=false

# ─── Email (AWS SES, SendGrid, Postmark, Resend) ──────────────────────────────
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=AKIAIOSFODNN7EXAMPLE
SMTP_PASS=SMTP_PASSWORD_FROM_SES
EMAIL_FROM=noreply@yourdomain.com

# ─── URLs ─────────────────────────────────────────────────────────────────────
APP_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com
NODE_ENV=production

# ─── Stripe (live keys) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Feature flags ────────────────────────────────────────────────────────────
SKIP_VIRUS_SCAN=false
