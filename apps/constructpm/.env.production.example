# ConstructPM — Turnkey VPS production config
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.production` on the server, fill in the values, and keep it out of
# git (it's already gitignored). docker-compose.prod.yml reads these variables.
#
# The RS256 JWT key pair is NOT set here — it lives as two files under ./secrets
# (jwt_private.pem / jwt_public.pem). See DEPLOY.md.
#
# Generate strong secrets with: openssl rand -base64 36

# ─── Your domain (DNS A record must already point at this VPS) ────────────────
DOMAIN=app.os-funding.com

# ─── Postgres ─────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD  → the `constructpm` superuser (owns schema, runs migrations)
# CONSTRUCTPM_APP_PASSWORD → the RLS-scoped `constructpm_app` role the API uses
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser
CONSTRUCTPM_APP_PASSWORD=CHANGE_ME_app_role

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis

# ─── Object storage (in-stack MinIO) ──────────────────────────────────────────
# These become the MinIO root credentials AND the API's S3 credentials.
S3_ACCESS_KEY=CHANGE_ME_minio_user
S3_SECRET_KEY=CHANGE_ME_minio_password
S3_BUCKET_FILES=constructpm-files

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Symmetric secret is still required by the config schema (min 64 chars) even
# though production access tokens are signed with the RS256 key pair in ./secrets.
JWT_SECRET=CHANGE_ME_at_least_64_characters_long_random_string_xxxxxxxxxxxxxxxx
JWT_ISSUER=constructpm
JWT_AUDIENCE=constructpm-app

# ─── Email (optional — leave SMTP_HOST empty to disable outbound mail) ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@os-funding.com

# ─── Feature flags ────────────────────────────────────────────────────────────
# No ClamAV in the turnkey stack, so uploaded-file virus scanning is skipped.
SKIP_VIRUS_SCAN=true
