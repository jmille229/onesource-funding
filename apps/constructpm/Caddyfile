# ConstructPM — Caddy reverse proxy (automatic HTTPS via Let's Encrypt)
# DOMAIN and APPLY_DOMAIN are injected from .env.production by
# docker-compose.prod.yml.
#
# Caddy is the only public entrypoint and terminates TLS, so it is the single
# place browser-facing security headers are set for the web bundle. nginx (the
# web container) deliberately sets none: nginx's `add_header` is not inherited
# into a location block that has its own add_header, so a header set at server
# level silently disappeared for exactly the responses that mattered — index.html
# and the hashed assets. Setting them here applies to every response uniformly.

# Site-wide headers. `?` sets a header only when the upstream did not, so the
# API's own values win on /api/* and nothing is duplicated. `-Server` drops the
# version banner.
(site_headers) {
	header {
		?Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Headers that only make sense for the HTML document and its assets.
(spa_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

{$DOMAIN} {
	# Compress API JSON and anything nginx did not already compress. List
	# responses are the bulk of the bytes and compress 5–10x.
	encode zstd gzip

	# Uploads are capped at 50 MB in the API; allow for multipart framing and
	# reject anything larger here so it never reaches Node.
	request_body {
		max_size 60MB
	}

	# API + health go to the Express container. `handle` blocks are mutually
	# exclusive; the API routes must win over the catch-all web route below.
	# Express sets its own (stricter, JSON-appropriate) CSP and security headers,
	# so nothing is added for these routes beyond the site-wide set.
	handle /api/* {
		reverse_proxy api:3001
	}

	handle /health {
		reverse_proxy api:3001
	}

	# Everything else is the React single-page app (nginx serves index.html and
	# handles client-side routing).
	handle {
		import spa_headers
		reverse_proxy web:80
	}

	import site_headers
}

# The public funding application (apply.os-funding.com). Same web bundle — it
# shows only the application on this host — but only the application's own API
# is reachable here. Login, tenant and operator routes answer 404, so this host
# is not a second door into the software or the console.
{$APPLY_DOMAIN} {
	encode zstd gzip

	# Application documents are capped at 25 MB each in the API.
	request_body {
		max_size 30MB
	}

	handle /api/apply/* {
		reverse_proxy api:3001
	}

	handle /api/* {
		respond "Not found" 404
	}

	handle {
		import spa_headers
		reverse_proxy web:80
	}

	import site_headers
}
