# ConstructPM Local Development Environment
# Copy to .env.local and fill in values (defaults work for local Docker stack)

NODE_ENV=development

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=3001
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# ─── Database (matches docker-compose) ────────────────────────────────────────
# The APP must connect as `constructpm_app` — a role WITHOUT BYPASSRLS, so every
# query is forced through the tenant RLS policies (V002). Do NOT use the owner
# role `constructpm` here: table owners bypass RLS and tenant isolation is lost.
DATABASE_URL=postgresql://constructpm_app:constructpm_app_dev@localhost:5432/constructpm_dev
DATABASE_READER_URL=postgresql://constructpm_app:constructpm_app_dev@localhost:5432/constructpm_dev
# Migrations/seed run as the admin role `constructpm` (owner + BYPASSRLS + CREATEROLE):
MIGRATION_DATABASE_URL=postgresql://constructpm:constructpm_dev@localhost:5432/constructpm_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=constructpm_redis_dev

# ─── JWT — REQUIRED in all environments (no default) ─────────────────────────────
# In production, use RS256 with real key pairs
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_ISSUER=constructpm-dev
JWT_AUDIENCE=constructpm-app

# ─── Storage (MinIO locally) ──────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# REQUIRED — no default. Dev MinIO creds shown here; use real credentials in production.
S3_ACCESS_KEY=constructpm
S3_SECRET_KEY=constructpm_minio_dev
S3_BUCKET_FILES=constructpm-files
S3_BUCKET_QUARANTINE=constructpm-quarantine
S3_FORCE_PATH_STYLE=true

# ─── Email (MailHog locally) ──────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=noreply@constructpm.local

# ─── Stripe (mocked — no real keys needed for local dev) ─────────────────────
STRIPE_SECRET_KEY=sk_test_mock_key
STRIPE_WEBHOOK_SECRET=whsec_mock_secret

# ─── Feature flags ────────────────────────────────────────────────────────────
SKIP_VIRUS_SCAN=true
