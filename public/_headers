# Security headers for the marketing site (os-funding.com).
#
# Cloudflare Workers static assets apply this file to every response. Vite
# copies public/ into dist/ verbatim, so this lands next to index.html.
#
# CSP notes:
#   - script-src 'self'        Vite emits hashed module files, no inline scripts.
#   - style-src 'unsafe-inline' framer-motion and Radix set inline style
#                              attributes; a nonce cannot cover attributes.
#   - fonts.googleapis.com /   Google Fonts stylesheet and the font files it
#     fonts.gstatic.com        pulls in.
#   - connect-src 'self' +     The "Get Started" form POSTs leads to Web3Forms
#     api.web3forms.com        (see GetStartedSection.tsx). Without this origin
#                              the browser blocks the submission. If the lead
#                              provider ever changes, change this host too.
#   - frame-ancestors 'none'   Nothing should embed the site.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.web3forms.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
